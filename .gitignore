# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/node_modules/
/public/ocr/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build / release artifacts (never commit)
# ---------------------------------------------------------------------------
/dist/
/dist-server/
/out/
/build/
/release/
/hosting-bundle/
/coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Secrets & local env (NEVER commit real credentials)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.host.example
!.env.test.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
.jwt-secret

# ---------------------------------------------------------------------------
# Runtime / local data
# ---------------------------------------------------------------------------
/data/
/backups/
/tmp/
/temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Local QA / phase log dumps
# ---------------------------------------------------------------------------
/local-phase-*-logs/
/certification-logs/
/deployment-logs/
/audit-word-evidence/
/audit-word-render/
/FINAL VERSION/
/FINAL\ VERSION/

# ---------------------------------------------------------------------------
# Archives / packages accidentally left in repo root
# ---------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
!docs/**/*.md

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
._*
**/._*
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Private statement corpus (owner-authorized PDFs; never commit)
# ---------------------------------------------------------------------------
/.local/
/docs/statements-v2/evidence/private/

# ---------------------------------------------------------------------------
# Test scratch
# ---------------------------------------------------------------------------
/tests/tmp-*
/tests/snapshots/*.local.json
/docs/finance-vnext/evidence-final/screenshots/

# ---------------------------------------------------------------------------
# Large generated evidence dumps (keep markdown summaries; ignore bulky logs)
# ---------------------------------------------------------------------------
/docs/finance-vnext/evidence-final/*.txt
/docs/finance-vnext/evidence-final/*.json
!/docs/finance-vnext/evidence-final/.gitkeep
