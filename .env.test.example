# PHASE 0 — Sample env for the test database.
# Copy to .env.test (gitignored) and fill in real values for a LOCAL test DB.
# Never point this at the production database.

APP_ENV=test
APP_BASE_URL=http://localhost:5000

# Test database — name MUST contain the substring "test"
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASS=
TEST_DB_NAME=sparowvault_test

# JWT — throwaway for local tests only; SHA-256 is in known_bad_jwt_secret_hashes()
# so this value cannot boot APP_ENV=production.
CLOUD_JWT_SECRET=test-only-please-rotate
CLOUD_JWT_EXPIRES_IN=2h

# Razorpay — test-mode keys only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend API base for browser/cloud e2e
VITE_API_BASE_URL=http://localhost:5000
