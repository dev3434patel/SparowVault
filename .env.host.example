# SparowVault — production .env template (placeholder-only)
#
# This file is the source of truth used by scripts/package-hosting.mjs to seed
# release/hosting-bundle/.env.host. NEVER fill in real secrets here.
# See docs/production-secrets.md for the production setup procedure.

DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASS=""

# Optional full DSN; if set, overrides DB_* above.
# DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DB_NAME"

# REQUIRED — generate per deployment via: openssl rand -hex 64
CLOUD_JWT_SECRET=""
CLOUD_JWT_EXPIRES_IN="7d"

APP_ENV="production"
APP_BASE_URL=""
CORS_ALLOWED_ORIGINS=""
ENABLE_RAZORPAY="false"

# Required when ENABLE_RAZORPAY=true.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

VITE_API_BASE_URL=""
VITE_CLOUD_ONLY_MODE="true"
VITE_ENABLE_RAZORPAY="false"
