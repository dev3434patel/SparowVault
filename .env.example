# SparowVault — selector + documentation of all env keys (PHASE_10)
# Copy to .env and point APP_ENV_FILE at a private file that is NEVER committed.
#
#   cp .env.example .env
#   cp .env.host.example .env.local
#   # then set APP_ENV_FILE=".env.local"
#
# Real secrets belong only in the private file or the host's environment panel.
# See docs/company/SECRETS_ROTATION.md and docs/production-secrets.md.

APP_ENV_FILE=".env.local"
# APP_ENV_FILE=".env.host"

# ---- Keys expected in the private env file (placeholders only here) ----
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=sparowvault
# DB_USER=root
# DB_PASS=
# DATABASE_URL=
#
# CLOUD_JWT_SECRET=          # openssl rand -hex 64
# CLOUD_JWT_EXPIRES_IN=7d
#
# APP_ENV=development        # development | staging | production
# APP_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# ENABLE_RAZORPAY=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
#
# VITE_API_BASE_URL=
# VITE_CLOUD_ONLY_MODE=true
# VITE_ENABLE_RAZORPAY=false
#
# BACKUP_DIR=                # absolute path outside web root
# BACKUP_OFFSITE_DIR=        # optional second copy
# MYSQLDUMP_BIN=mysqldump
# MYSQL_BIN=mysql
# KEEP_DAYS=14
#
# COMPANY_STAGING_URL=https://staging.example.com
# HEADERS_CHECK_URL=
# TRUSTED_PROXY_IPS=
